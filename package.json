{
  "name": "open-teleprompter",
  "version": "3.0.0",
  "description": "Voice-activated teleprompter for Mac and Windows",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "dev:react": "vite",
    "build": "tauri build",
    "build:frontend": "vite build",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "lint": "eslint . --max-warnings 0",
    "snap:save": "node scripts/snap.mjs save",
    "snap:check": "node scripts/snap.mjs check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "vite": "^8.0.7"
  },
  "dependencies": {
    "@tiptap/extension-color": "^3.22.3",
    "@tiptap/extension-text-style": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.12"
  }
